# Optional personal defaults for bootstrap.sh's questions.
# Copy to local.env (git-ignored) and uncomment what you need:
#   cp local.env.example local.env
# Each value is only a default: it is still shown, validated and can be changed at the prompt.
# Anything left out is derived from the running system:
#   hostname and timezone from the system, SSH user from sudo, static IP from the
#   interface's current address, DNS and admin networks = the Pi's own subnet.

#DEFAULT_HOST_NAME=dns
#DEFAULT_ADMIN_USER=pi
# Import this GitHub user's public SSH keys (https://github.com/<user>.keys), synced hourly.
#DEFAULT_GITHUB_USER=octocat
#DEFAULT_TIMEZONE=Europe/Amsterdam
#DEFAULT_LAN_CIDR=192.168.10.53/24

# Serve DNS to your Tailscale devices too (adblock away from home, works behind CGNAT).
#DEFAULT_TAILSCALE=yes

# Example for a router with VLANs: every network may use DNS,
# only the main and trusted networks may use SSH and the web UI.
#DEFAULT_DNS_SUBNETS="192.168.10.0/24 192.168.20.0/24 192.168.30.0/24 192.168.40.0/24"
#DEFAULT_ADMIN_SUBNETS="192.168.10.0/24 192.168.20.0/24"
