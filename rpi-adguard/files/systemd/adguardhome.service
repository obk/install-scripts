[Unit]
Description=AdGuard Home DNS filter
Documentation=https://github.com/AdguardTeam/AdGuardHome/wiki
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adguardhome
Group=adguardhome
# In-app updates are disabled; agh-update.timer installs new releases (checksum-verified,
# rolled back if DNS stops answering).
ExecStart=/opt/AdGuardHome/AdGuardHome --no-check-update \
    -c /var/lib/adguardhome/AdGuardHome.yaml -w /var/lib/adguardhome
Restart=on-failure
RestartSec=5s

StateDirectory=adguardhome
StateDirectoryMode=0700
UMask=0077

# Only privilege needed: binding port 53 and 80 as a non-root user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# AF_NETLINK: interface/address enumeration for bind_hosts and ARP client discovery.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
