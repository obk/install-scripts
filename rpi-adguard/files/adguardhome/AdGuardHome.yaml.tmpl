# AdGuard Home configuration (schema 34, AdGuard Home v0.107.79).
# Rendered once by bootstrap.sh; AdGuard Home rewrites the live copy and drops these comments.
# Placeholders (written as ${NAME} below, never in comments: envsubst would expand them here too):
#   LAN_IP GATEWAY AGH_BIND_HOSTS AGH_ALLOWED_CLIENTS AGH_ADMIN_USER AGH_ADMIN_HASH
http:
  pprof:
    port: 6060
    enabled: false
  doh:
    routes:
      - GET /dns-query
      - POST /dns-query
      - GET /dns-query/{ClientID}
      - POST /dns-query/{ClientID}
    insecure_enabled: false
  # Port 80 only redirects to HTTPS (force_https); ufw limits both to the admin networks.
  address: ${LAN_IP}:80
  session_ttl: 12h
users:
  - name: ${AGH_ADMIN_USER}
    password: ${AGH_ADMIN_HASH}
auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: ""
theme: auto
dns:
  # The LAN IP, plus the Tailscale IP when enabled (one "    - <address>" line each).
  bind_hosts:
    - 127.0.0.1
${AGH_BIND_HOSTS}
  port: 53
  anonymize_client_ip: false
  # Per client IP: with the default /24, all devices of a VLAN would share one budget.
  ratelimit: 100
  ratelimit_subnet_len_ipv4: 32
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist: []
  refuse_any: true
  upstream_dns:
    - https://dns.quad9.net/dns-query
    - tls://dns.quad9.net
    - https://cloudflare-dns.com/dns-query
    - tls://one.one.one.one
  upstream_dns_file: ""
  # Plain DNS used only to resolve the encrypted upstreams' hostnames.
  bootstrap_dns:
    - 9.9.9.9
    - 149.112.112.112
    - 1.1.1.1
    - 1.0.0.1
  fallback_dns: []
  upstream_mode: parallel
  fastest_timeout: 1s
  # Only the host itself, the DNS client networks and, with Tailscale, the tailnet (one "    - <subnet>" line each) may query.
  allowed_clients:
    - 127.0.0.1
${AGH_ALLOWED_CLIENTS}
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies:
    - 127.0.0.0/8
  cache_enabled: true
  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: true
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
  bogus_nxdomain: []
  # IPv6 is disabled on this network.
  aaaa_disabled: true
  enable_dnssec: true
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: 300
  handle_ddr: true
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: 10s
  private_networks: []
  use_private_ptr_resolvers: true
  # Reverse lookups for LAN addresses go to the router only, never upstream.
  local_ptr_upstreams:
    - ${GATEWAY}
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
  use_http3_upstreams: false
  serve_plain_dns: true
  hostsfile_enabled: true
  pending_requests:
    enabled: true
# Self-signed certificate for the web UI, generated by bootstrap.sh.
tls:
  enabled: true
  server_name: ""
  force_https: true
  port_https: 443
  # Encrypted DNS listeners are not wanted; 0 disables them.
  port_dns_over_tls: 0
  port_dns_over_quic: 0
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  certificate_chain: ""
  private_key: ""
  certificate_path: /etc/adguardhome/tls/cert.pem
  private_key_path: /etc/adguardhome/tls/key.pem
  strict_sni_check: false
querylog:
  dir_path: ""
  ignored: []
  interval: 7d
  size_memory: 1000
  enabled: true
  ignored_enabled: false
  file_enabled: true
statistics:
  dir_path: ""
  ignored: []
  interval: 7d
  enabled: true
  ignored_enabled: false
filters:
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt
    name: AdAway Default Blocklist
    id: 2
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_48.txt
    name: HaGeZi's Pro Blocklist
    id: 3
whitelist_filters: []
user_rules: []
dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false
filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: Local
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: false
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  rewrites: []
  safe_fs_patterns: []
  max_http_size: 256MB
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 24
  blocked_response_ttl: 10
  filtering_enabled: true
  rewrites_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  protection_enabled: true
clients:
  runtime_sources:
    # Off: whois would send public client IPs to third-party servers.
    whois: false
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent: []
log:
  enabled: true
  # Empty means stderr, which systemd sends to the journal.
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false
os:
  group: ""
  user: ""
  rlimit_nofile: 0
schema_version: 34
